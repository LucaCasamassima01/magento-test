<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="codestorm_product_note" resource="default" engine="innodb">

    <column xsi:type="int" unsigned="true" name="note_id" nullable="false" identity="true"/>

    <column xsi:type="int" unsigned="true" name="customer_id" nullable="false"/>
    <column xsi:type="int" unsigned="true" name="product_id" nullable="false"/>

    <column xsi:type="varchar" name="content" nullable="false" length="255"/>

    <column xsi:type="timestamp" name="created_at" nullable="false"
            default="CURRENT_TIMESTAMP"/>

    <column xsi:type="timestamp" name="updated_at" nullable="false"
            default="CURRENT_TIMESTAMP"
            on_update="true"/>

    <constraint xsi:type="primary" referenceId="PRIMARY">
        <column name="note_id"/>
    </constraint>

    <constraint xsi:type="foreign"
                referenceId="FK_PRODUCT_NOTE_CUSTOMER"
                table="codestorm_product_note"
                column="customer_id"
                referenceTable="customer_entity"
                referenceColumn="entity_id"
                onDelete="CASCADE"/>

    <constraint xsi:type="foreign"
                referenceId="FK_PRODUCT_NOTE_PRODUCT"
                table="codestorm_product_note"
                column="product_id"
                referenceTable="catalog_product_entity"
                referenceColumn="entity_id"
                onDelete="CASCADE"/>

</table>
</schema>