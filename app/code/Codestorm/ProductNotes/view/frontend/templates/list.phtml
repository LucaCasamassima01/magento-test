<div class="product-notes">
    <h2>My Product Notes</h2>

    <?php if ($notes->getSize()): ?>
        <table class="notes-table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Note</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
            <?php foreach ($notes as $note): ?>
                <tr>
                    <td>
                        <span class="badge">
                            #<?= (int) $note->getProductId(); ?>
                        </span>
                    </td>
                    <td><?= $block->escapeHtml($note->getContent()); ?></td>
                    <td><?= $note->getCreatedAt(); ?></td>
                </tr>
            <?php endforeach; ?>
            </tbody>
        </table>
    <?php else: ?>
        <div class="empty-state">
            No notes found.
        </div>
