<?php $notes = $block->getNotes(); ?>

<style>
    .product-notes {
        margin: 20px 0;
        font-family: Arial, sans-serif;
    }

    .product-notes h2 {
        font-size: 22px;
        margin-bottom: 15px;
        color: #333;
    }

    .notes-table {
        width: 1200px;
        border-collapse: collapse;
        background: #fff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .notes-table thead {
        background: #2b2f36;
        color: #fff;
    }

    .notes-table th,
    .notes-table td {
        padding: 12px 15px;
        text-align: left;
        font-size: 14px;
    }

    .notes-table tbody tr {
        border-bottom: 1px solid #eee;
        transition: background 0.2s ease;
    }

    .notes-table tbody tr:hover {
        background: #f7f9fc;
    }

    .badge {
        display: inline-block;
