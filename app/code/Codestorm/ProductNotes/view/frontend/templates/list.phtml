<div class="product-notes">
    <h2>My Product Notes</h2>

    <div id="product-notes-container">
        <div class="empty-state">Loading...</div>
    </div>
</div>

<style>
    .product-notes {
        margin: 20px 0;
        font-family: Arial, sans-serif;
    }

    .product-notes h2 {
        font-size: 22px;
        margin-bottom: 15px;
        color: #333;
    }

    .notes-table {
        width: 1200px;
        border-collapse: collapse;
        background: #fff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .notes-table thead {
        background: #2b2f36;
        color: #fff;
    }

    .notes-table th,
    .notes-table td {
        padding: 12px 15px;
        text-align: left;
        font-size: 14px;
    }

    .notes-table tbody tr {
        border-bottom: 1px solid #eee;
        transition: background 0.2s ease;
    }

    .notes-table tbody tr:hover {
        background: #f7f9fc;
    }

    .badge {
        display: inline-block;
        padding: 4px 8px;
        font-size: 12px;
        border-radius: 12px;
        background: #e3f2fd;
        color: #1565c0;
    }

    .action-link {
        color: #1565c0;
        text-decoration: none;
        margin-right: 8px;
    }

    .action-link:hover {
        text-decoration: underline;
    }

    .empty-state {
        padding: 15px;
        background: #fafafa;
        border: 1px dashed #ddd;
        border-radius: 6px;
        color: #666;
    }
</style>

<script>
async function loadNotes() {

    const container = document.getElementById('product-notes-container');

    try {
        const response = await fetch('/graphql', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': 'Bearer <?= $block->getCustomerToken() ?>'
            },
            body: JSON.stringify({
                query: `
                    query {
                        customerProductNotes {
                            note_id
                            product_id
                            content
                            created_at
                        }
                    }
                `
            })
        });

        const json = await response.json();

        const notes = json?.data?.customerProductNotes || [];

        if (!notes.length) {
            container.innerHTML = `
                <div class="empty-state">
                    No notes found.
                </div>
            `;
            return;
        }

        container.innerHTML = `
            <table class="notes-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Note</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    ${notes.map(note => `
                        <tr>
                            <td>
                                <span class="badge">
                                    #${note.product_id}
                                </span>
                            </td>

                            <td>
                                ${escapeHtml(note.content ?? '')}
                            </td>

                            <td>
                                ${note.created_at ?? ''}
                            </td>

                            <td>
                                <a class="action-link"
                                   href="/productnotes/note/edit/id/${note.note_id}">
                                    Edit
                                </a>

                                <a class="action-link"
                                   href="/productnotes/note/delete/id/${note.note_id}"
                                   onclick="return confirm('Are you sure you want to delete this note?')">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    `).join('')}
                </tbody>
            </table>
        `;

    } catch (e) {
        container.innerHTML = `
            <div class="empty-state">
                Error loading notes.
            </div>
        `;
        console.error(e);
    }
}

function escapeHtml(str) {
    return String(str)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
}

loadNotes();
</script>